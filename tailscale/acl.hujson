// Tailscale policy file (HuJSON: JSON + // comments).
// Applied by Terraform via tailscale_acl.main_policy in main.tf.
{
  // Who is allowed to apply each tag when authenticating a node.
  "tagOwners": {
    // Generic tag for containerized/headless nodes.
    "tag:container": [
      "autogroup:admin"
    ],
    // Always-on exit node.
    "tag:permanent-exit-node": [
      "autogroup:admin"
    ],
    // Taiwan app connector — advertises routes for the escape-china domains.
    "tag:tw-limited-trust": [
      "autogroup:admin"
    ],
    // Any computer placed in location, acting as both an exit node and perform
    // computation, including running of docker containers.
    "tag:local-compute": [
      "autogroup:admin"
    ]
  },
  // Access rules. Currently wide open within the tailnet.
  "acls": [
    {
      "action": "accept",
      "src": [
        "autogroup:member",
        "tag:container",
      ],
      "dst": [
        "*:*", // any tailnet node, any port
        "autogroup:internet:*" // exit-node traffic
      ]
    },
    {
      "action": "accept",
      "src": [
        "autogroup:member"
      ],
      "dst": [
        "tag:local-compute:*"
      ]
    }
  ],
  // Tailscale SSH: members may SSH to their own devices, subject to a
  // periodic re-auth check.
  "ssh": [
    {
      "action": "check",
      "src": [
        "autogroup:member"
      ],
      "dst": [
        "autogroup:self"
      ],
      "users": [
        "autogroup:nonroot",
        "root"
      ]
    },
    {
      "action": "accept",
      "src": [
        "autogroup:admin"
      ],
      "dst": [
        "tag:local-compute"
      ],
      "users": [
        "ivan",
        "root"
      ],
    },
  ],
  "nodeAttrs": [
    {
      "target": [
        "*"
      ],
      "app": {
        // App connector "escape-china": the single place to list any
        // destination that must not egress from inside the GFW. Traffic
        // to these domains is routed through the tag:tw-limited-trust
        // node (Taiwan egress) instead of the default route; everything
        // else takes the normal path. The connector resolves these
        // domains and advertises the resulting IPs as routes.
        //
        // Add a domain here rather than creating a second connector, so
        // "what has to escape China" stays answerable from one list.
        // Note: routes outside the ranges in autoApprovers below land as
        // pending approvals in the admin console.
        "tailscale.com/app-connectors": [
          {
            "name": "escape-china",
            "connectors": [
              "tag:tw-limited-trust"
            ],
            "domains": [
              // Claude / Anthropic
              "claude.ai",
              "*.claude.ai",
              "claude.com",
              "*.claude.com",
              "anthropic.com",
              "*.anthropic.com",
              // TikTok (app + web). CDN hostnames vary by region, so
              // expect to extend this list as new ones show up.
              "tiktok.com",
              "*.tiktok.com",
              "tiktokcdn.com",
              "*.tiktokcdn.com",
              "tiktokcdn-us.com",
              "*.tiktokcdn-us.com",
              "tiktokv.com",
              "*.tiktokv.com",
              "tiktokv.us",
              "*.tiktokv.us",
              "ttwstatic.com",
              "*.ttwstatic.com",
              "byteoversea.com",
              "*.byteoversea.com",
              "ibytedtos.com",
              "*.ibytedtos.com",
              "ibyteimg.com",
              "*.ibyteimg.com",
              "musical.ly",
              "*.musical.ly"
            ]
          }
        ]
      }
    },
    {
      // Allow members to expose services publicly via Tailscale Funnel.
      "target": [
        "autogroup:member"
      ],
      "attr": [
        "funnel"
      ]
    },
    {
      // Mullvad exit-node access for this specific device.
      "target": [
        "100.85.174.62"
      ],
      "attr": [
        "mullvad"
      ]
    }
  ],
  "autoApprovers": {
    // Auto-approve routes advertised by the escape-china app connector,
    // so a re-resolve doesn't require manual approval in the admin console.
    // Only the Anthropic ranges are listed; TikTok/ByteDance resolves into
    // ByteDance and third-party CDN space that is too large and too
    // volatile to enumerate, so those routes currently arrive pending.
    "routes": {
      "160.79.104.0/21": [
        "tag:tw-limited-trust"
      ],
      "2607:6bc0::/32": [
        "tag:tw-limited-trust"
      ]
    },
    // These tags may advertise themselves as exit nodes without approval.
    "exitNode": [
      "tag:permanent-exit-node",
      "tag:tw-limited-trust",
      "tag:local-compute"
    ]
  },
  "grants": [
    {
      // Allow admins to access any device with the tag "tag:container"
      "src": [
        "autogroup:admin"
      ],
      "dst": [
        "tag:container"
      ],
      "app": {
        "tailscale.com/cap/tsidp": [
          {
            // allow access to UI
            "allow_admin_ui": true,
            // Security Token Service (STS) controls
            "users": [
              "*"
            ],
            "resources": [
              "*"
            ],
          },
        ],
      },
    },
  ],
}