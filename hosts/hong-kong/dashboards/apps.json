{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "description": "Every service on hong-kong: where it can be reached, whether it is running, and what it costs. Exposure and addresses are generated from the repository by hosts/hong-kong/catalogue.nix; everything else is live.",
  "editable": false,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "What is running",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Services",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "One row per catalogued service. `Exposure` and `Address` come from fleet_service_info, which is generated from the repository at build time \u2014 a compose file's x-fleet.public plus the zone in public.nix \u2014 because whether something is on the public internet is a fact about the config, not something the machine can be asked. Everything else is live.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "info",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "fleet_service_info",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "up",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "max by (name) (node_systemd_unit_state{state=\"active\"})",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "mem",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "fleet_service_memory_bytes",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "cpu",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "rate(fleet_service_cpu_seconds_total[5m])",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^name$",
            "renamePattern": "unit"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "unit",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "instance 4": true,
              "state": true,
              "Value #info": true
            },
            "indexByName": {
              "service": 0,
              "kind": 1,
              "exposure": 2,
              "public": 3,
              "tailnet": 4,
              "Value #up": 5,
              "Value #mem": 6,
              "Value #cpu": 7,
              "unit": 8
            },
            "renameByName": {
              "service": "Service",
              "kind": "Kind",
              "exposure": "Exposure",
              "public": "Public address",
              "tailnet": "Tailnet address",
              "Value #up": "Active",
              "Value #mem": "Memory",
              "Value #cpu": "CPU",
              "unit": "Unit"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Active"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "active",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "NOT ACTIVE",
                        "color": "red",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "no unit",
                        "color": "text",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Exposure"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "public": {
                        "text": "PUBLIC",
                        "color": "orange",
                        "index": 0
                      },
                      "tailnet": {
                        "text": "tailnet",
                        "color": "blue",
                        "index": 1
                      },
                      "internal": {
                        "text": "internal",
                        "color": "text",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Exposure",
            "desc": false
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "type": "row",
      "title": "Exposure at a glance",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "On the public internet",
      "description": "Services a stranger can reach. `grep -rn 'public:' hosts/hong-kong/apps/` is the same answer from the repo side, and the two should never disagree.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "count(fleet_service_info{exposure=\"public\"}) or vector(0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "On the tailnet only",
      "description": "Reachable by you, not by strangers.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "count(fleet_service_info{exposure=\"tailnet\"}) or vector(0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Internal only",
      "description": "Loopback only \u2014 reachable from the box itself.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "count(fleet_service_info{exposure=\"internal\"}) or vector(0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Catalogued but NOT active",
      "description": "A service in the catalogue whose unit is not running. Zero is the expected value; anything else is either a real outage or a stale unit name in catalogue.nix.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "count(fleet_service_info unless on (unit) label_replace(max by (name) (node_systemd_unit_state{state=\"active\"}) == 1, \"unit\", \"$1\", \"name\", \"(.*)\")) or vector(0)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "What they cost",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Memory by service",
      "description": "Current memory charged to each unit's cgroup \u2014 native services and containers measured identically, which is why this does not use cAdvisor. The box has 7.6 GB and architecture.md budgets roughly 3 GB of it to Immich.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "fleet_service_memory_bytes",
          "legendFormat": "{{unit}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "CPU by service",
      "description": "Cores in use, per unit. 1.0 means one core saturated; this machine has two. Sampled every 30s, so treat it as a trend rather than a spike detector.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "rate(fleet_service_cpu_seconds_total[5m])",
          "legendFormat": "{{unit}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "fleet"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Apps and exposure",
  "uid": "fleet-apps",
  "version": 1
}
