    {
      "type": "table",
      "title": "Failed units",
      "description": "Empty is the correct state. Anything here has been failed since the last scrape; `systemctl status <unit>` on the box says why.",
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "node_systemd_unit_state{state=\"failed\"} == 1",
          "legendFormat": "",
          "range": false,
          "editorMode": "code",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "state": true,
              "fleet": true,
              "type": true
            },
            "renameByName": {
              "instance": "Host",
              "name": "Unit"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
